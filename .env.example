# --- Database (matches docker-compose.yml) ---
KB_DATABASE_URL=postgresql://kb:kb@localhost:5433/kb
# Schema for the knowledge-base tables; use a dedicated one when sharing a database with another app.
# Local Postgres example: KB_DATABASE_URL=postgresql://postgres:<password>@localhost:5432/askgov_dev  +  KB_DB_SCHEMA=kb
# (URL-encode special characters in the password, e.g. @ -> %40)
KB_DB_SCHEMA=public

# --- Embeddings (called through LiteLLM) ---
OPENAI_API_KEY=sk-...
KB_EMBEDDING_MODEL=text-embedding-3-small
KB_EMBEDDING_DIM=1536
# Optional: route through a LiteLLM proxy / Azure / other OpenAI-compatible base URL
# KB_EMBEDDING_API_BASE=http://localhost:4000
# Send `dimensions=` to the API (text-embedding-3-* only) to shorten vectors
# KB_EMBEDDING_SEND_DIMENSIONS=false

# --- Rerank (Cohere). Leave empty to fall back to vector order. ---
COHERE_API_KEY=
KB_RERANK_MODEL=rerank-v3.5

# --- Relevance cut: below this the query returns status=no_relevant_context ---
# Rerank score (0-1) when Cohere is available; cosine similarity when it isn't.
KB_MIN_RERANK_SCORE=0.3
KB_MIN_VECTOR_SCORE=0.2

# --- Chunking ---
KB_CHUNK_SIZE=512
KB_CHUNK_OVERLAP=64
# tokens | chars
KB_CHUNK_LENGTH_UNIT=tokens

# --- OCR for scanned PDFs ---
# auto = OCR pages with no text layer | force = OCR every page | off
KB_OCR_MODE=auto
# rapidocr (pip only) | tesseract (needs Tesseract on PATH + pip install pytesseract)
KB_OCR_ENGINE=rapidocr
KB_OCR_DPI=300

# --- Uploads ---
KB_MAX_UPLOAD_MB=50

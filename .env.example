# Copy to .env and fill in the keys. Every KB_* setting is optional; the values shown are the defaults
# (see src/kb/config.py for the full list and notes).

# --- API keys -----------------------------------------------------------------------------------------
# embeddings, query router, topic tagging, answers, graph extraction
OPENAI_API_KEY=
# rerank; empty = results in retrieval order (reranked: false)
COHERE_API_KEY=

# --- Database -----------------------------------------------------------------------------------------
KB_DATABASE_URL=postgresql://kb:kb@localhost:5433/kb
# one schema per knowledge base, e.g. kb_large
KB_DB_SCHEMA=public
# KB_DB_POOL_SIZE=10

# --- Embeddings (LiteLLM) -----------------------------------------------------------------------------
KB_EMBEDDING_MODEL=text-embedding-3-large
# must match the vector column; changing it needs a fresh schema
KB_EMBEDDING_DIM=1536
KB_EMBEDDING_SEND_DIMENSIONS=true
# LiteLLM proxy or Azure endpoint
# KB_EMBEDDING_API_BASE=
# KB_EMBEDDING_BATCH_SIZE=128

# --- Rerank and relevance cut -------------------------------------------------------------------------
KB_RERANK_MODEL=rerank-v4.0-pro
KB_MIN_RERANK_SCORE=0.5
KB_MIN_VECTOR_SCORE=0.245

# --- Chunking -----------------------------------------------------------------------------------------
# structure | recursive
KB_CHUNK_STRATEGY=structure
KB_CHUNK_SIZE=512
KB_CHUNK_OVERLAP=64
# tokens | chars
KB_CHUNK_LENGTH_UNIT=tokens
# KB_CHUNK_MIN_TOKENS=150
# KB_STRUCTURE_MIN_HEADINGS=3
# KB_TABLE_EXTRACTION=true

# --- Topic tagging at ingest (LLM) --------------------------------------------------------------------
KB_TOPIC_TAGGING=true
# KB_TOPIC_MODEL=gpt-4.1-mini
# KB_TOPIC_MAX_PER_SECTION=3

# --- Query router (LLM) -------------------------------------------------------------------------------
KB_QUERY_ROUTER=true
# KB_ROUTER_MODEL=gpt-4.1-mini
# KB_ROUTER_MIN_WORDS=5
# KB_ROUTER_MAX_SUBQUESTIONS=3
# KB_MAX_MERGED_RESULTS=10
# KB_LIST_TOP_K=10
# KB_PROCESS_MAX_CHUNKS=8

# --- Answer generation (kb ask, MCP ask, kb deepeval) -------------------------------------------------
# KB_GENERATION_MODEL=gpt-4o-mini

# --- Knowledge graph (Neo4j); graph search is on whenever KB_NEO4J_PASSWORD is set ------------------
# KB_NEO4J_URI=bolt://localhost:7687
# KB_NEO4J_USER=neo4j
# KB_NEO4J_PASSWORD=
# KB_NEO4J_DATABASE=neo4j
# KB_GRAPH_SEARCH=true
# KB_GRAPH_WEIGHT=1.0
# KB_GRAPH_HOPS=2
# KB_GRAPH_TIMEOUT_S=5
# KB_GRAPH_EXTRACTION_MODEL=gpt-4.1-mini
# KB_GRAPH_WINDOW_TOKENS=20000
# KB_GRAPH_MAX_OUTPUT_TOKENS=16000
# KB_GRAPH_CONCURRENCY=4
# KB_GRAPH_ALIASES_FILE=

# --- OCR for scanned PDF pages ------------------------------------------------------------------------
# auto | force | off
# KB_OCR_MODE=auto
# rapidocr | tesseract
# KB_OCR_ENGINE=rapidocr
# KB_OCR_DPI=300

# --- Knowledge drift ----------------------------------------------------------------------------------
# KB_MAX_DOCUMENT_AGE_DAYS=365
# KB_SOURCE_TIMEOUT_S=30

# --- Servers ------------------------------------------------------------------------------------------
# KB_MAX_UPLOAD_MB=50
# required to expose `kb mcp` beyond localhost
# KB_MCP_TOKEN=

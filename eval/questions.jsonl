# --- BIRT_GRO_Guyana_Chatbot_Knowledge_Base.pdf ---
{"id": "birth-01", "question": "deadline to register a newborn", "reference": "Register the birth within 14 days, normally at the hospital or health centre where the child was born.", "expected": [{"chunk_id": "BIRT_GRO_Guyana_Chatbot_Knowledge_Base_chunk_0"}]}
{"id": "birth-02", "question": "who is allowed to register a baby", "reference": "The parent or legal guardian of a child born in Guyana.", "expected": [{"chunk_id": "BIRT_GRO_Guyana_Chatbot_Knowledge_Base_chunk_2"}]}
{"id": "birth-03", "question": "what papers do I bring to register my baby", "reference": "The child's name with the correct spelling, the parents' National ID cards or valid photo ID, the marriage certificate if applicable, and the hospital birth notification or medical confirmation of birth.", "expected": [{"chunk_id": "BIRT_GRO_Guyana_Chatbot_Knowledge_Base_chunk_3"}]}
{"id": "birth-04", "question": "is there a charge for registering a birth", "reference": "No. Birth registration is free; you only pay if you request a birth certificate.", "expected": [{"chunk_id": "BIRT_GRO_Guyana_Chatbot_Knowledge_Base_chunk_3"}]}
{"id": "birth-05", "question": "price of a birth certificate copy", "reference": "A regular birth certificate is GYD $300 per copy; an expedited one is GYD $3,000 per copy.", "expected": [{"chunk_id": "BIRT_GRO_Guyana_Chatbot_Knowledge_Base_chunk_3"}]}
{"id": "birth-06", "question": "how long until a regular birth certificate arrives by post", "reference": "The GRO Forms page says 3-6 weeks when applying through a Post Office; another notice mentions 7 days, so confirm with the GRO at +592 226-1291 if timing matters.", "expected": [{"chunk_id": "BIRT_GRO_Guyana_Chatbot_Knowledge_Base_chunk_3"}]}
{"id": "birth-07", "question": "I need my birth certificate within a day", "reference": "Use the expedited service: GYD $3,000 per copy, processed within 24 hours once processing and payment requirements are met. Apply at the GRO office or via WhatsApp +592 610-9394 or groonlineapplication@gmail.com.", "expected": [{"chunk_id": "BIRT_GRO_Guyana_Chatbot_Knowledge_Base_chunk_3"}]}
{"id": "birth-08", "question": "address of the main general register office", "reference": "The main GRO office is at the G.P.O. Building, Robb Street, Georgetown, in Region 4.", "expected": [{"chunk_id": "BIRT_GRO_Guyana_Chatbot_Knowledge_Base_chunk_3"}]}
{"id": "birth-09", "question": "can I apply for a birth certificate by whatsapp or email", "reference": "Yes, for the expedited service: WhatsApp +592 610-9394 or email groonlineapplication@gmail.com.", "expected": [{"chunk_id": "BIRT_GRO_Guyana_Chatbot_Knowledge_Base_chunk_1"}]}
{"id": "birth-10", "question": "what details does the birth certificate application form ask for", "reference": "Full name/surname, date of birth, sex, place of birth, mother's name/maiden name, father's name, and the name and address the certificate should be sent to.", "expected": [{"chunk_id": "BIRT_GRO_Guyana_Chatbot_Knowledge_Base_chunk_6"}]}
{"id": "birth-11", "question": "my surname is spelled wrong on my birth certificate", "reference": "A spelling mistake is a clerical error handled through the minor correction process with the Minor Clerical Application Form; after GRO review the record is amended and a corrected certificate can be issued.", "expected": [{"chunk_id": "BIRT_GRO_Guyana_Chatbot_Knowledge_Base_chunk_10"}]}
{"id": "birth-12", "question": "my child is 3 years old and was never registered", "reference": "Formal Late Registration applies when a child is 1 year or older and was never registered; it needs a notarized affidavit plus supporting evidence such as a hospital/midwife statement, clinic card, school letter or ID.", "expected": [{"chunk_id": "BIRT_GRO_Guyana_Chatbot_Knowledge_Base_chunk_6"}]}
{"id": "birth-13", "question": "which regions do not have a GRO office", "reference": "No GRO office is listed for Regions 3, 5, 7, 8 and 10; residents there can use the Post Office, WhatsApp/email, outreach or the main Georgetown office.", "expected": [{"chunk_id": "BIRT_GRO_Guyana_Chatbot_Knowledge_Base_chunk_1"}]}
{"id": "birth-14", "question": "does the registry office visit villages", "reference": "Yes. GRO outreach makes temporary visits to communities; no schedule is published, so contact the GRO at +592 610-9394.", "expected": [{"chunk_id": "BIRT_GRO_Guyana_Chatbot_Knowledge_Base_chunk_6"}]}
{"id": "birth-15", "question": "is there a birth registry office in Anna Regina", "reference": "Yes. The Region 2 GRO office is at the Regional Democratic Office compound in Anna Regina, phone +592 610-9394.", "expected": [{"chunk_id": "BIRT_GRO_Guyana_Chatbot_Knowledge_Base_chunk_6"}]}
{"id": "birth-16", "question": "is registering a birth the same as getting a birth certificate", "reference": "No. Registering records the birth in the official register; a birth certificate is a certified copy of that record. You must register first, then apply for the certificate.", "expected": [{"chunk_id": "BIRT_GRO_Guyana_Chatbot_Knowledge_Base_chunk_1"}]}
{"id": "birth-17", "question": "I can't find my birth certificate anywhere, how do I replace it", "reference": "Apply for a new certified copy with the Birth Certificate Application Form; it is not a new registration. Regular is GYD $300 (3-6 weeks) and expedited is GYD $3,000 (within 24 hours).", "expected": [{"chunk_id": "BIRT_GRO_Guyana_Chatbot_Knowledge_Base_chunk_14"}]}
{"id": "birth-18", "question": "we are not married, can we still register our son", "reference": "Yes. The marriage certificate is only required if applicable; bring the child's name, the parents' ID and the hospital birth notification. Registration is free.", "expected": [{"chunk_id": "BIRT_GRO_Guyana_Chatbot_Knowledge_Base_chunk_15"}]}
{"id": "birth-19", "question": "how much does it cost to correct a birth record", "reference": "A correction fee isn't published; ask the GRO when you submit the form. If a new certificate is needed afterwards, standard fees apply (GYD $300 regular or GYD $3,000 expedited).", "expected": [{"chunk_id": "BIRT_GRO_Guyana_Chatbot_Knowledge_Base_chunk_10"}]}
{"id": "birth-20", "question": "how do I pay for the expedited birth certificate", "reference": "Payment methods for the expedited service aren't published; the GRO will tell you how to pay when you apply, or ask via WhatsApp +592 610-9394.", "expected": [{"chunk_id": "BIRT_GRO_Guyana_Chatbot_Knowledge_Base_chunk_10"}]}

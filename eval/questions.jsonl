# --- GRO_Guyana_Death_Services_Knowledge_Base(1).pdf ---
{"id": "death-01", "question": "which office records a death in my area", "reference": "Register the death in person with the District Registrar for the area where the death happened.", "expected": [{"chunk_id": "GRO_Guyana_Death_Services_Knowledge_Base_chunk_2"}]}
{"id": "death-02", "question": "how many days do I have to report a death", "reference": "Give notice within 7 days of the death and provide the full details within 14 days.", "expected": [{"chunk_id": "GRO_Guyana_Death_Services_Knowledge_Base_chunk_3"}]}
{"id": "death-03", "question": "do we pay anything to record my father's passing", "reference": "No. Registering a death is free; fees apply only to certified copies of the death certificate.", "expected": [{"chunk_id": "GRO_Guyana_Death_Services_Knowledge_Base_chunk_3"}]}
{"id": "death-04", "question": "can the funeral home register the death for us", "reference": "Yes. A funeral director can register the death with a signed letter of authority.", "expected": [{"chunk_id": "GRO_Guyana_Death_Services_Knowledge_Base_chunk_7"}]}
{"id": "death-05", "question": "can I register a death on the internet", "reference": "No. Registering a new death is offline only; you must go in person to the District Registrar. Only death certificate applications can be partly handled online.", "expected": [{"chunk_id": "GRO_Guyana_Death_Services_Knowledge_Base_chunk_3"}]}
{"id": "death-06", "question": "what information about the person who died will the registrar ask", "reference": "The deceased's full name, date of birth, occupation, address and parents' names.", "expected": [{"chunk_id": "GRO_Guyana_Death_Services_Knowledge_Base_chunk_3"}]}
{"id": "death-07", "question": "my grandfather had no national id card, what can we use", "reference": "The deceased's ID can be a National ID, passport or birth certificate, so a passport or birth certificate will work.", "expected": [{"chunk_id": "GRO_Guyana_Death_Services_Knowledge_Base_chunk_5"}]}
{"id": "death-08", "question": "it has been over two weeks and the death is not registered", "reference": "If more than 14 days have passed, contact the GRO directly because late registration needs extra steps: +592 226-1291 or WhatsApp +592 610-9394.", "expected": [{"chunk_id": "GRO_Guyana_Death_Services_Knowledge_Base_chunk_5"}]}
{"id": "death-09", "question": "what time does the general register office open", "reference": "The GRO at the GPO Building, Robb Street, Georgetown is open Monday to Thursday 8:00 am-4:30 pm and Friday 8:00 am-3:30 pm.", "expected": [{"chunk_id": "GRO_Guyana_Death_Services_Knowledge_Base_chunk_5"}]}
{"id": "death-10", "question": "death certificate price", "reference": "A standard death certificate is GYD $300 and the expedited service is GYD $3,000.", "expected": [{"chunk_id": "GRO_Guyana_Death_Services_Knowledge_Base_chunk_5"}]}
{"id": "death-11", "question": "regular death certificate, how many days until I receive it", "reference": "About 7 days, plus postal time.", "expected": [{"chunk_id": "GRO_Guyana_Death_Services_Knowledge_Base_chunk_5"}]}
{"id": "death-12", "question": "which email do I send a death certificate application to", "reference": "Send it to groguyana@gmail.com, or use WhatsApp +592 610-9394.", "expected": [{"chunk_id": "GRO_Guyana_Death_Services_Knowledge_Base_chunk_15"}]}
{"id": "death-13", "question": "where do I download the death certificate application form", "reference": "Download the fillable Death Certificate Application Form from the GRO website, gro.moha.gov.gy.", "expected": [{"chunk_id": "GRO_Guyana_Death_Services_Knowledge_Base_chunk_7"}]}
{"id": "death-14", "question": "I live in Region 5, where can I apply for a death certificate", "reference": "At the regional government service centre at Fort Wellington (Region 5), or at any post office.", "expected": [{"chunk_id": "GRO_Guyana_Death_Services_Knowledge_Base_chunk_0"}]}
{"id": "death-15", "question": "what counts as a small mistake on a death certificate", "reference": "Minor (clerical) errors include a spelling mistake in a name, a wrong digit in a date, or a wrong address or occupation.", "expected": [{"chunk_id": "GRO_Guyana_Death_Services_Knowledge_Base_chunk_7"}]}
{"id": "death-16", "question": "my father died in hospital, do I register it myself", "reference": "Hospital staff can register a death that happens in a hospital, so ask the hospital; you can also register it yourself if you were present at the death.", "expected": [{"chunk_id": "GRO_Guyana_Death_Services_Knowledge_Base_chunk_9"}]}
{"id": "death-17", "question": "do we register at our local registrar or the one where the hospital is", "reference": "Register with the District Registrar for the area where the death happened, which is the area where the hospital is located.", "expected": [{"chunk_id": "GRO_Guyana_Death_Services_Knowledge_Base_chunk_9"}]}
{"id": "death-18", "question": "how soon can we bury my grandmother", "reference": "Once the death is registered, you can arrange the burial or cremation.", "expected": [{"chunk_id": "GRO_Guyana_Death_Services_Knowledge_Base_chunk_5"}]}
{"id": "death-19", "question": "the reason of death written on the certificate is incorrect", "reference": "A cause of death change isn't listed as a minor correction; contact the GRO at +592 226-1291 to ask what's required.", "expected": [{"chunk_id": "GRO_Guyana_Death_Services_Knowledge_Base_chunk_15"}]}
{"id": "death-20", "question": "I need three death certificate copies, what is the total cost", "reference": "The standard fee is GYD $300 and expedited is GYD $3,000, but it isn't stated whether fees are per copy, so confirm the total for three copies with the GRO at +592 226-1291.", "expected": [{"chunk_id": "GRO_Guyana_Death_Services_Knowledge_Base_chunk_16"}]}

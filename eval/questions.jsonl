# GRO / Cash Grant evaluation set: 20 questions per PDF (80) + 5 off-topic questions that should be refused.
# Questions are paraphrased (not copied from the PDFs' own Q&A) so they test retrieval, not exact-text lookup.
# `expected` items are chunk ids (<document>_chunk_<chunk_index>), one chunk per item.
# They follow chunk_index: after re-chunking, regenerate from eval/questions_contains.jsonl with
# python scripts/expected_to_chunk_ids.py eval/questions_contains.jsonl --single > eval/questions.jsonl
# `reference` is the correct answer as plain text (used by `kb deepeval`); off-topic questions have none.
#
# --- cash_grant (1)(1).pdf ---
{"id": "cash-01", "question": "how much money is the national cash grant", "reference": "Each eligible citizen receives GY$100,000 (one hundred thousand Guyanese dollars).", "expected": [{"chunk_id": "cash_grant_chunk_0"}]}
{"id": "cash-02", "question": "do I have to pay the grant back later", "reference": "No. The Cash Grant is not a loan; recipients do not have to repay the GY$100,000.", "expected": [{"chunk_id": "cash_grant_chunk_0"}]}
{"id": "cash-03", "question": "why is the government giving people this money", "reference": "To give people direct financial support for household expenses, and to increase financial inclusion by paying mainly through bank transfers so people have their own bank accounts.", "expected": [{"chunk_id": "cash_grant_chunk_0"}]}
{"id": "cash-04", "question": "when did they start paying out the grant", "reference": "Distribution began on March 19, 2026, starting with central government employees whose salaries were already paid into bank accounts.", "expected": [{"chunk_id": "cash_grant_chunk_0"}]}
{"id": "cash-05", "question": "when did the registration website open", "reference": "The online registration portal was launched on March 26, 2026.", "expected": [{"chunk_id": "cash_grant_chunk_0"}]}
{"id": "cash-06", "question": "how old do I need to be to get the 100k grant", "reference": "You must be at least 18 years old on February 28, 2026.", "expected": [{"chunk_id": "cash_grant_chunk_0"}]}
{"id": "cash-07", "question": "can I sign up for the grant while I am living abroad", "reference": "No. Applicants must be physically present in Guyana when registering.", "expected": [{"chunk_id": "cash_grant_chunk_0"}]}
{"id": "cash-08", "question": "which ID can I use to register for the cash grant", "reference": "You need at least one accepted ID: a valid National ID or a valid Guyana passport.", "expected": [{"chunk_id": "cash_grant_chunk_1"}]}
{"id": "cash-09", "question": "why does the portal need my phone camera", "reference": "Registration includes identity verification; the phone camera is used to capture your ID document and complete face verification.", "expected": [{"chunk_id": "cash_grant_chunk_1"}]}
{"id": "cash-10", "question": "can I use a US phone number to register", "reference": "No. Only registration requires a +592 Guyanese mobile number for SMS verification.", "expected": [{"chunk_id": "cash_grant_chunk_1"}]}
{"id": "cash-11", "question": "my wife and I share one phone, can we both register with it", "reference": "No. Each applicant needs their own unique phone number; someone without their own number can get help at a Cash Grant Centre.", "expected": [{"chunk_id": "cash_grant_chunk_1"}]}
{"id": "cash-12", "question": "is a taxpayer number required for the cash grant", "reference": "No. A Taxpayer Identification Number (TIN) is optional.", "expected": [{"chunk_id": "cash_grant_chunk_1"}]}
{"id": "cash-13", "question": "which banks can receive the grant payment", "reference": "Demerara Bank, GBTI, Republic Bank and Scotiabank.", "expected": [{"chunk_id": "cash_grant_chunk_2"}]}
{"id": "cash-14", "question": "can the money be deposited into my mother's account", "reference": "No. The bank account for direct payment must be in the applicant's own name, not a parent's or spouse's.", "expected": [{"chunk_id": "cash_grant_chunk_2"}]}
{"id": "cash-15", "question": "I have no bank account, how will I get paid", "reference": "You can open an account with a participating bank; if you cannot, an alternative payment method such as a cheque may be available. Use the portal's Get Help option or contact the Help Desk.", "expected": [{"chunk_id": "cash_grant_chunk_2"}]}
{"id": "cash-16", "question": "how long does Republic Bank take to approve an online account", "reference": "Republic Bank states its online application review takes one business day, but full activation is not guaranteed in that time and may need extra verification or a branch visit.", "expected": [{"chunk_id": "cash_grant_chunk_3"}]}
{"id": "cash-17", "question": "how many minutes does it take to fill in the online registration", "reference": "Online registration takes approximately 10 minutes.", "expected": [{"chunk_id": "cash_grant_chunk_4"}]}
{"id": "cash-18", "question": "after I am verified, when will the money reach my account", "reference": "After successful verification, payment to an active bank account may be credited within 24 hours, though processing times can vary.", "expected": [{"chunk_id": "cash_grant_chunk_4"}]}
{"id": "cash-19", "question": "I stopped my application halfway, how do I finish it", "reference": "Log in to the Cash Grant Portal and use the Continue Application option.", "expected": [{"chunk_id": "cash_grant_chunk_4"}]}
{"id": "cash-20", "question": "cash grant help desk phone number", "reference": "The Cash Grant Help Desk numbers are +592 501-5085 and +592 503-2977.", "expected": [{"chunk_id": "cash_grant_chunk_1"}]}

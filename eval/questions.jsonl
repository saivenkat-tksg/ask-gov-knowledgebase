# --- GRO_Guyana_Marriage_Services_Knowledge_Base(1).pdf ---
{"id": "marriage-01", "question": "can a 17 year old get married in guyana", "reference": "A person aged 16-17 may marry only with the required parental consent; otherwise both parties must be 18 or older.", "expected": [{"chunk_id": "GRO_Guyana_Marriage_Services_Knowledge_Base_chunk_1"}]}
{"id": "marriage-02", "question": "how many days must we be in Guyana before the marriage licence", "reference": "At least one party must have been resident in Guyana for 15 consecutive days before the licence is issued.", "expected": [{"chunk_id": "GRO_Guyana_Marriage_Services_Knowledge_Base_chunk_0"}]}
{"id": "marriage-03", "question": "can a foreigner marry in guyana", "reference": "Yes. Non-residents must obtain a marriage licence and provide a passport as identification, and at least one party must have been resident in Guyana for 15 consecutive days before the licence is issued.", "expected": [{"chunk_id": "GRO_Guyana_Marriage_Services_Knowledge_Base_chunk_2"}]}
{"id": "marriage-04", "question": "what does marriage by banns mean", "reference": "Marriage by banns is where a permanent resident arranges for a religious leader to publish the banns (a public notice of the intended marriage), followed by the ceremony, registration and certificate.", "expected": [{"chunk_id": "GRO_Guyana_Marriage_Services_Knowledge_Base_chunk_2"}]}
{"id": "marriage-05", "question": "documents needed for a marriage licence", "reference": "Both people need their birth certificate (original and photocopy) and ID (National ID card or passport; passport for non-residents), plus divorce, death certificate or deed poll documents if they apply.", "expected": [{"chunk_id": "GRO_Guyana_Marriage_Services_Knowledge_Base_chunk_12"}]}
{"id": "marriage-06", "question": "I am divorced, what paper do I need to remarry", "reference": "The original and a photocopy of your Absolute/Divorce document, with the original court seal or stamp.", "expected": [{"chunk_id": "GRO_Guyana_Marriage_Services_Knowledge_Base_chunk_3"}]}
{"id": "marriage-07", "question": "my husband died, what do I need to marry again", "reference": "The original and a photocopy of your previous spouse's Death Certificate, together with your birth certificate and ID.", "expected": [{"chunk_id": "GRO_Guyana_Marriage_Services_Knowledge_Base_chunk_4"}]}
{"id": "marriage-08", "question": "where can I get the marriage petition form", "reference": "Download the Marriage Petition Form from the GRO website, or get the marriage package at a local Post Office.", "expected": [{"chunk_id": "GRO_Guyana_Marriage_Services_Knowledge_Base_chunk_0"}]}
{"id": "marriage-09", "question": "why do I need a JP for the marriage petition", "reference": "The completed Marriage Petition must be notarized by a Justice of the Peace, who checks, witnesses and signs, stamps or certifies it before it is submitted to the GRO.", "expected": [{"chunk_id": "GRO_Guyana_Marriage_Services_Knowledge_Base_chunk_4"}]}
{"id": "marriage-10", "question": "what do we pay to get permission to marry", "reference": "The marriage licence fee is G$5,000.", "expected": [{"chunk_id": "GRO_Guyana_Marriage_Services_Knowledge_Base_chunk_8"}]}
{"id": "marriage-11", "question": "how many days to process a marriage licence", "reference": "About 3-4 business days after the notarized petition is submitted to the GRO.", "expected": [{"chunk_id": "GRO_Guyana_Marriage_Services_Knowledge_Base_chunk_4"}]}
{"id": "marriage-12", "question": "how long can I use my marriage licence before it runs out", "reference": "A marriage licence is valid for 90 days from the date of issue.", "expected": [{"chunk_id": "GRO_Guyana_Marriage_Services_Knowledge_Base_chunk_4"}]}
{"id": "marriage-13", "question": "after the wedding who registers the marriage and by when", "reference": "The Marriage Officer must lodge the Registration of Marriage with the GRO within 14 days of the marriage.", "expected": [{"chunk_id": "GRO_Guyana_Marriage_Services_Knowledge_Base_chunk_10"}]}
{"id": "marriage-14", "question": "price for a copy of our wedding certificate", "reference": "A marriage certificate is G$300 per copy for the regular service or G$3,000 per copy for the expedited service.", "expected": [{"chunk_id": "GRO_Guyana_Marriage_Services_Knowledge_Base_chunk_6"}]}
{"id": "marriage-15", "question": "we need our marriage certificate fast for a visa", "reference": "Use the expedited service: G$3,000 per copy via WhatsApp +592 610-9394 or groonlineapplication@gmail.com, processed within 24 hours after payment is confirmed and collected at the GRO. The marriage must be registered first.", "expected": [{"chunk_id": "GRO_Guyana_Marriage_Services_Knowledge_Base_chunk_6"}]}
{"id": "marriage-16", "question": "can I do the whole marriage licence application online", "reference": "The Government Portal labels it Completely online, but the GRO's instructions say to visit the GRO with the notarized petition and originals, so plan to visit and confirm with the GRO.", "expected": [{"chunk_id": "GRO_Guyana_Marriage_Services_Knowledge_Base_chunk_0"}]}
{"id": "marriage-17", "question": "my fiance is Canadian, can we get married by banns at church", "reference": "The banns route is described for permanent residents, and non-residents must obtain a licence, so a Canadian fiance should use the licence route.", "expected": [{"chunk_id": "GRO_Guyana_Marriage_Services_Knowledge_Base_chunk_8"}]}
{"id": "marriage-18", "question": "we married last month but the GRO has no record of it", "reference": "The Marriage Officer must lodge the registration within 14 days, so check with your Marriage Officer first, then contact the GRO (+592 226-1291 or WhatsApp +592 610-9394), and escalate to the Ministry of Home Affairs if unresolved.", "expected": [{"chunk_id": "GRO_Guyana_Marriage_Services_Knowledge_Base_chunk_14"}]}
{"id": "marriage-19", "question": "what happens if our marriage licence expires before the wedding", "reference": "The available information doesn't say what happens after the 90 days; contact the GRO at +592 226-1291 to ask about reapplying.", "expected": [{"chunk_id": "GRO_Guyana_Marriage_Services_Knowledge_Base_chunk_10"}]}
{"id": "marriage-20", "question": "we got married in the USA, do we register it in guyana", "reference": "The information only covers marriages performed in Guyana; contact the GRO at +592 226-1291 or WhatsApp +592 610-9394 to ask whether and how a foreign marriage can be recorded.", "expected": [{"chunk_id": "GRO_Guyana_Marriage_Services_Knowledge_Base_chunk_16"}]}

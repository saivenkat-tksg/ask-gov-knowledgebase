# MoHA Guyana Booklet evaluation set: 25 answerable questions + 8 that should be refused.
# Questions are paraphrased (not copied from the booklet) so they test retrieval, not exact-text lookup.
# `contains` phrases are verified to appear in the booklet's chunks (structure chunking, kb_large, 2026-10-12);
# they match by text, so they keep working after re-chunking. Avoid words the PDF writes with ligatures (ﬁ, ﬂ).
# Run: kb eval eval/questions_booklet.jsonl --compare --delay 6.5
#
# --- GRO: roles and processes ---
{"id": "gro-01", "question": "who is in charge of printing birth and death certificates at the registry office", "reference": "Print users print the certificates; the Print Supervisor allocates printing work and logs the total number of certificates printed.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "Print Supervisor logs the total number"}]}
{"id": "gro-02", "question": "do I have to pay to register a birth", "reference": "No. Registrations are free of cost; only payments for processing the certificate are required.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "Registrations are free of cost"}]}
{"id": "gro-03", "question": "which law covers registering births and deaths", "reference": "The Registration of Births and Deaths is governed by Act 44:01.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "governed by Act 44:01"}]}
{"id": "gro-04", "question": "what legislation sets the requirements for getting married", "reference": "Requirements for marriage are specified by the Marriage Act 45:01.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "Marriage Act 45:01"}]}
{"id": "gro-05", "question": "where is a baby born at home registered", "reference": "Home births and deaths are recorded at the nearest Health Centre.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "Home Births and Deaths are recorded at the nearest Health Centre"}]}
{"id": "gro-06", "question": "what happens first when someone hands in an application at the GRO", "reference": "The receptionist receives the application at the front desk, logs it, and gives the applicant a slip with a return date and the application to take to the cashier.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "Receptionist receives application"}]}
{"id": "gro-07", "question": "how long after applying should I come back for my certificate", "reference": "The applicant is given a return date within 2 weeks of applying.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "within 2 weeks of applying"}]}
{"id": "gro-08", "question": "how does the search supervisor split up the applications for the searchers", "reference": "The Search Supervisor receives the applications and places them in piles of 40, which are distributed to searchers.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "piles of 40"}]}
{"id": "gro-09", "question": "what does the searcher do", "reference": "The searcher is responsible for searching the database for the relevant information.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "Searcher is responsible for searching"}]}
{"id": "gro-10", "question": "what happens when a record needs to be corrected", "reference": "The corrections clerk cancels the entry, places it in a corrections box, then it is entered into the IMS and verified before printing.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "corrections clerk cancels the entry"}]}
{"id": "gro-11", "question": "who has to lodge the registration of a marriage", "reference": "Marriage officers are required by law to lodge the registration of marriages.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "Marriage officers are required by law"}]}
{"id": "gro-12", "question": "what must be done with foreign certificates before an overseas birth is registered", "reference": "Translated copies of the foreign certificates must be verified in person before registrations are issued.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "translated copies of the foreign"}]}

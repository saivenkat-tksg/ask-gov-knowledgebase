# --- Ministry of Home Affairs: firearms, TINT, procurement, personnel ---
{"id": "moha-01", "question": "how old do you need to be to apply for a gun licence", "reference": "Applicants must be at least 25 years old to apply.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "applicants must be at least 25 years old"}]}
{"id": "moha-02", "question": "is there a firearm licence application for gun dealers", "reference": "Yes. The Application for Firearm License by a Dealer is one of the forms handled by the Firearms Secretary; licensed dealers must keep a record of each firearm or ammunition purchase, sale or transfer.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "Application for Firearm License by a Dealer"}]}
{"id": "moha-03", "question": "could the tint waiver process bring in money for the ministry", "reference": "Yes. A desired capability is to collect a fee for the TINT process, which could generate revenue; currently no fees are collected.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "Collect a fee for the TINT process"}]}
{"id": "moha-04", "question": "how does the ministry buy goods and services through procurement", "reference": "A tender is sent out for bid, bids are collected and evaluated by a board, and a contract is awarded.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "A Tender is sent out for bid"}]}
{"id": "moha-05", "question": "how could leave requests be handled in an HR system", "reference": "The leave application form could be held in the HRIS system 30 days in advance of a request, with reminders sent to the Personnel supervisor and the employee's supervisor.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "Leave application form could be held in HRIS"}]}

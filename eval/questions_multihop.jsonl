# MoHA Guyana Booklet multi-hop evaluation set: every question needs two facts, often from different pages.
# Each `expected` item is one link of the chain; `recall` = share of links found in the top results,
# `hit@k` = at least one link found. A question is fully answered only when recall is 1 for it.
# `contains` phrases are verified against the booklet's chunks (kb_large, 2026-10-12).
# Run: kb eval eval/questions_multihop.jsonl --compare --top-k 5 --delay 6.5
{"id": "mh-01", "question": "Which law governs the certificates the GRO print team produces, and how many applications does each searcher get?", "reference": "Birth and death certificates are governed by Act 44:01; the Search Supervisor distributes applications in piles of 40.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "governed by Act 44:01"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "piles of 40"}]}
{"id": "mh-02", "question": "Home births are recorded where, and which act governs registering births?", "reference": "Home births are recorded at the nearest Health Centre; registration of births and deaths is governed by Act 44:01.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "Home Births and Deaths are recorded at the nearest Health Centre"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "governed by Act 44:01"}]}
{"id": "mh-03", "question": "Who has to lodge marriage registrations, and which act sets the requirements for marriage?", "reference": "Marriage officers must lodge the registration of marriages; requirements are set by the Marriage Act 45:01.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "Marriage officers are required by law"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "Marriage Act 45:01"}]}
{"id": "mh-04", "question": "Is registering a birth free, and where do I pay for the certificate at the GRO?", "reference": "Registration is free; only the certificate processing is paid, at the cashier, who issues a receipt.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "Registrations are free of cost"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "Application is given to cashier"}]}
{"id": "mh-05", "question": "What is wrong with the TINT waiver process today, and how could it bring in revenue?", "reference": "Large volumes of hardcopy applications and one employee make it slow, and no payment is required; a proposed capability is to collect a fee for the TINT process.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "lost revenue opportunity"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "Collect a fee for the TINT process"}]}
{"id": "mh-06", "question": "How old must a firearm licence applicant be, and what would moving the firearms application online change?", "reference": "Applicants must be at least 25; the application would be completed online with data sent to a dedicated database, easing use and processing.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "applicants must be at least 25 years old"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "Application is completed online"}]}
{"id": "mh-07", "question": "Community policing groups use radios where there is no internet: how far can they reach, and what do the groups want for sharing knowledge?", "reference": "The radios only work within a 6-mile radius; the groups want a central repository / data repository to share knowledge.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "6-mile radius"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "central repository"}]}
{"id": "mh-08", "question": "When an error is found in a GRO record, who cancels the entry, and what is the usual return date for a certificate?", "reference": "The corrections clerk cancels the entry; applicants normally get a return date within 2 weeks of applying.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "corrections clerk cancels the entry"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "within 2 weeks of applying"}]}
{"id": "mh-09", "question": "For a visa application, who pays the fee and how is the applicant finally told it was approved?", "reference": "The applicant or sponsor pays the fee and Accounts issues a receipt; the Visa Clerk notifies the applicant of final approval by phone.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "Applicant/sponsor pays fee"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "Visa Clerk notifies applicant of final approval"}]}
{"id": "mh-10", "question": "For a community police ID card, how is the photo obtained and who gives the final approval?", "reference": "The photo and signature are clipped electronically from the scanned form; the Administrator approves and gives the card to the Liaison.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "Photo and signature are electronically clipped"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "Administrator approves and gives"}]}
{"id": "mh-11", "question": "Compare how a convicted inmate and a remanded inmate can be released.", "reference": "Convicted: sentence expires, appeal with bail, fine paid, parole or pardon. Remanded: bail paid or matter discharged by the court.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "Sentence expires"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "Bail has been paid"}]}
{"id": "mh-12", "question": "What check is done before a firearm form is processed, and is there a licence application for gun dealers?", "reference": "A background check is completed before the form is processed; yes, the Application for Firearm License by a Dealer.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "background check is completed"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "Application for Firearm License by a Dealer"}]}

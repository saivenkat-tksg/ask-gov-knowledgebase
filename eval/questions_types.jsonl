# MoHA Guyana Booklet question-type evaluation set: 42 answerable questions (6 per type) + 4 that should be refused.
# Types: normal (one fact, one chunk), multi_intent (two independent questions in one sentence),
# multi_hop (true chain: the bridge entity is never named, so hop 2 can only be found after hop 1),
# comparison (same aspect across two agencies/processes), conditional (a user's situation decides the rule),
# list (items collected from 3-5 places; may exceed top-5 on purpose), process (ordered steps spread over chunks),
# off (sounds in-domain but the booklet does not answer it; expected is empty).
# `expected` has one item per fact/chunk needed for a full answer; `contains` is matched lowercase with whitespace
# collapsed. Phrases were verified against the booklet's kb_large chunks on 2026-10-13 (each matches 1-2 chunks).
# Questions are paraphrased and do not repeat questions_booklet.jsonl or questions_multihop.jsonl.
# Run: kb eval eval/questions_types.jsonl --compare --delay 6.5
#
# --- normal: one fact from one chunk ---
{"id": "nor-01", "type": "normal", "question": "How dark is window tint allowed to be when the traffic department inspects a car?", "reference": "During the physical inspection the tint can be no darker than 65%.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "The tint can be no darker than 65%"}]}
{"id": "nor-02", "type": "normal", "question": "Roughly how many community policing groups and volunteers are there in Guyana?", "reference": "There are approximately 340 Community Policing Groups with a total membership of over 7300 volunteers.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "approximately 340 CPGs with a total membership of over 7300"}]}
{"id": "nor-03", "type": "normal", "question": "Where do newly sworn prison officers do their residential training before being posted?", "reference": "New prison officers undergo 3 months of live-in training at the Cecil Kilkenny Prison Officers' Training School at Lusignan, focusing on the Prison Act (11:01) and the Basic Recruit Training Manual.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "training at the Cecil Kilkenny Prison"}]}
{"id": "nor-04", "type": "normal", "question": "What is the most passports the passport office has managed to print in one day?", "reference": "The maximum printed in one day has been 700-800 passports; future demand is expected to be at least three times that.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "The maximum printed in one day has been 700-800"}]}
{"id": "nor-05", "type": "normal", "question": "Which international quality standard is the forensic laboratory accredited to?", "reference": "GFSL runs a fully accredited ISO/IEC 17025:2017 quality assurance program for forensic testing and calibration.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "fully accredited ISO/IEC 17025: 2017 international standard"}]}
{"id": "nor-06", "type": "normal", "question": "How soon after admission does a new prisoner have to be examined by the medical team?", "reference": "The medical team must see the inmate within 24 hours, as required by law (with exceptions for Sunday).", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "within 24 hours as required by law"}]}
#
# --- multi_intent: two independent questions in one sentence ---
{"id": "int-01", "type": "multi_intent", "question": "How many personnel does the Fire and Rescue Service have, and how much does it cost to get a passport in 72 hours?", "reference": "GFS has approximately 678 personnel (250 short of its authorized strength). The expedited passport fee (72 hours) is $20,000.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "With a strength of approximately 678 personnel"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "Expedited fee (72 hours) is $20,000"}]}
{"id": "int-02", "type": "multi_intent", "question": "How many people work for CANU, and what is the staff size of the forensic science lab?", "reference": "CANU has 128 employees at its Georgetown headquarters and 4 satellite locations; GFSL has a staff strength of approximately 29 personnel.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "has 128 employees working at CANU headquarters"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "staff strength of approximately 29 personnel"}]}
{"id": "int-03", "type": "multi_intent", "question": "On what day do prisoners get their Tuc Shop items, and how long does it take to approve a minor fire incident report?", "reference": "Tuc Shop items are delivered to inmates weekly on Wednesdays by Tuc Shop orderlies. Minor fire incident reports currently take 24 to 72 hours to get through the chain of command.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "each Wednesday, items are delivered to inmates"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "Minor Incident Reports currently take 24 to 72 hours"}]}
{"id": "int-04", "type": "multi_intent", "question": "How many years of old paper records is the juvenile holding centre typing into its new database, and what ID do forensic lab guards accept from visitors?", "reference": "A data entry clerk is entering about 8 years of backlog paper records into the JHC Database (roughly half done, back to 2018). GFSL security verifies a Police ID card, National ID card or driver's licence.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "8 years of backlog records from paper files"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "GFSL Security verifies either Police ID Card, National ID Card"}]}
{"id": "int-05", "type": "multi_intent", "question": "What do the colour codes in the prison admissions journal mean, and which regions have the worst internet for community policing?", "reference": "In the admissions journal red code means remanded and black or blue code means convicted. Internet is non-functional or intermittent especially in regions 9, 8, 7 and 1.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "Black or blue code = Convicted"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "especially in regions 9, 8, 7, and 1"}]}
{"id": "int-06", "type": "multi_intent", "question": "How long is the probation for new community policing members, and how many prisons does the Prison Service operate?", "reference": "CPG members serve a 90-day probationary period before receiving equipment, uniforms and ID badges. The Prison Service operates 6 prison facilities housing about 1800 offenders, plus a headquarters.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "after a 90-day probationary period are"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "operates 6 prison facilities housing approximately 1800"}]}
#
# --- multi_hop: the bridge entity is not named in the question ---
{"id": "hop-01", "type": "multi_hop", "question": "What computer system does the lab that receives CANU's sealed narcotics samples use to process evidence?", "reference": "CANU's narcotics samples are delivered to the Guyana Forensic Science Laboratory (GFSL), which uses the VeriPic System for evidence processing (and CIMS for biochemical tests).", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "director, and form/samples are delivered to GFSL"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "The VeriPic System is used for evidence processing"}]}
{"id": "hop-02", "type": "multi_hop", "question": "The authority that hosts the Prison Service's offender database also helped which other MoHA department build an electronic records system, and when?", "reference": "PRIMUS is hosted by the National Data Management Authority (NDMA); in mid-2022 the Juvenile Justice Department partnered with NDMA to implement the JHC Database for youths at the holding center.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "National Data Management Authority (NDMA) which hosts and supports PRIMUS"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "the department partnered with NDMA to implement an electronic"}]}
{"id": "hop-03", "type": "multi_hop", "question": "When a passport application raises an issue, clearance has to come from another office - what database does that office use for its records, and how long has it been in use?", "reference": "Clearance must be obtained from the General Register Office (GRO). The GRO uses the Identity Management System (IMS) database, which has only been in use within the past year and still lacks data security protocols.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "clearance for the issuance of the passport must be obtained from the"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "The Identity Management System database in use has only been in use"}]}
{"id": "hop-04", "type": "multi_hop", "question": "What is the name of the official who signs off on major fire incident reports?", "reference": "All major fire incident reports are reviewed and approved by the Minister of Home Affairs, who is Hon. Robeson Benn.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "All major incident reports are reviewed and approved by"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "The Minister of Home Affairs Hon. Robeson Benn"}]}
{"id": "hop-05", "type": "multi_hop", "question": "How many regional divisions does the organisation that background-checks mining visa applicants have?", "reference": "Mining applicants are background-checked by the Guyana Police Force, which has a main headquarters, the Felix Austin Police College and 12 Regional Division Headquarters plus many stations and outposts.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "background check on the applicant is conducted by the Guyana Police Force"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "Felix Austin Police College, 12 Regional Division Headquarters"}]}
{"id": "hop-06", "type": "multi_hop", "question": "How many officers does the NCP employ in the role that interviews people applying to join a community policing group?", "reference": "New CPG applicants are interviewed by the Liaison (Liaison Officer); the NCP employs 25 Liaison Officers to service Guyana's regions.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "Applicant is interviewed to ensure CPG member requirements are met"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "The NCP employs 25 Liaison Officers"}]}
#
# --- comparison: the same aspect across two agencies or processes ---
{"id": "cmp-01", "type": "comparison", "question": "How does leave approval work at MoHA Personnel compared with the Prison Service?", "reference": "At MoHA a hardcopy leave form goes to the Permanent Secretary and PPO, an Action Officer checks the leave file and drafts the letter; MoHA only approves lower-level employees' leave when overseas travel is involved. At the Prison Service, junior ranks' leave is approved internally by Prison Registry staff with executive management; requests from senior officers or involving international travel go to MoHA Personnel.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "MoHA only approves leave for lower-level employees if overseas travel"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "Leave requests for junior ranks are approved by Prison Registry staff"}]}
{"id": "cmp-02", "type": "comparison", "question": "Compare the problems CANU has with payment vouchers to the problems in the Prison Service's purchasing process.", "reference": "CANU's bills are not paid on time because MoHA Finance processing is delayed, so checks arrive after due dates and several vendors have cut service. The Prison Service's requisition-to-purchase process is time consuming, has limited inventory tracking, poor traceability, lack of space due to paper files and weak data security (no encryption, paper files transported).", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "This has resulted in service cuts to the agency by several vendors"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "with no encryption services and paper"}]}
{"id": "cmp-03", "type": "comparison", "question": "How does the crew's final radio call to the control room differ between a fire call-out and an ambulance call-out?", "reference": "On a fire call the Sub-Officer/Section Leader radios that the fire is extinguished with a return code, after which the Control Room announces All Clear. On a medical call the EMT/Section Lead radios crew reporting Code 48 (return to office) before the All Clear.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "radios Fire Extinguished and return Code to CR"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "radios in Crew reporting Code 48"}]}
{"id": "cmp-04", "type": "comparison", "question": "What reporting problems do the Juvenile Justice Department and the Prison Service have in common?", "reference": "Both use report templates and must send finished reports outside the system: Juvenile Justice staff use multiple programs to enter and send reports, and Prison reports are often printed and delivered outside the system. Both recommend a single centralized reporting interface/repository.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "Any items sent must be done so outside of the system"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "Sent reports often are printed and delivered outside of the system"}]}
{"id": "cmp-05", "type": "comparison", "question": "How are contract renewals handled at MoHA Personnel versus at CANU?", "reference": "At MoHA the agency sends a memo to contract heads requesting renewals, MoHA Personnel prepares a request for the Minister or Permanent Secretary, and the Action Officer calls the contractor in to sign. CANU tracks renewal dates in an Excel spreadsheet coded valid, about to expire (90 days or less) or expired.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "Agency prepares a memo sent to all Contract heads requesting contract renewals"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "An Excel spreadsheet is used to determine contract renewal dates"}]}
{"id": "cmp-06", "type": "comparison", "question": "What is recorded about a person when they arrive at the juvenile holding centre compared with a prison?", "reference": "At the juvenile holding centre a photo is taken and the youth's weight and height are recorded, then an admissions form is completed. At a prison the officer and prisoner are questioned for the penal record, a photo is taken with a portable camera and the inmate is fingerprinted.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "Photo is taken; the youths weight/height is recorded"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "Photo is taken with a portable camera, inmate is fingerprinted"}]}
#
# --- conditional: the user's situation decides which rule applies ---
{"id": "cnd-01", "type": "conditional", "question": "I'm a Venezuelan student who came into Guyana through Lethem and want to extend my stay - do I have to pay, or do I just get a letter?", "reference": "Extensions of stay can be given to students and visitors. Because Lethem is one of the listed ports (Lethem, Ogle, Timehri, Mason Creek), three copies of Voucher A are prepared for you to pay for the application; applicants from any other port of entry are issued an acknowledgement letter instead.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "Once the port of entry is Lethem, Ogle"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "Extension of Stay can be given to Students and Visitors"}]}
{"id": "cnd-02", "type": "conditional", "question": "I'm a chief officer in the Prison Service planning a holiday abroad - who has to approve my leave and how early should I apply?", "reference": "Because the request is for chief officer or above and involves international travel, the Director sends it to MoHA Personnel for approval. Staff are advised to submit leave requests six weeks in advance.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "If request is for chief officer or above or for international travel"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "recommends requesting leave six weeks in advance"}]}
{"id": "cnd-03", "type": "conditional", "question": "I'm 54 and work for an agency under MoHA - can I get some of my gratuity before I leave?", "reference": "Yes. After age 54 an employee may request an advance on gratuity (one of the MoHA Personnel processes).", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "after age 54 an employee may request for an advance"}]}
{"id": "cnd-04", "type": "conditional", "question": "During a CANU raid we found cash and guns rather than drugs - what happens to them?", "reference": "If money or firearms are discovered, CANU officers may turn them over to the police force, although CANU officers may still have to testify about the crime scene when the case goes to court.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "may turn them over to the police force"}]}
{"id": "cnd-05", "type": "conditional", "question": "If a suspect refuses to sign the officers' notes after a narcotics seizure, what is done instead?", "reference": "If the defendant refuses to sign, two officers sign.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "If defendant refuses to sign two officers sign"}]}
{"id": "cnd-06", "type": "conditional", "question": "My colleague's oil and gas permit is approved but he is offshore - can I collect the approval letter for him?", "reference": "Yes, the letter can be uplifted with a form of identification; if the person uplifting is not the applicant, an authorization letter and any form of identification are required.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "if person uplifting is not the applicant an authorization letter"}]}
#
# --- list: items collected from several places ---
{"id": "lst-01", "type": "list", "question": "Where in the Ministry's agencies is WhatsApp used to pass on work information?", "reference": "NCP Liaisons submit daily CPG activity to the Administrator via WhatsApp groups; CANU's Legal department posts case outcomes to a WhatsApp group; CANU remote locations send stores item lists via WhatsApp; the Prison infirmary communicates its staff leave roster via WhatsApp (NCP training dates are also sent via WhatsApp).", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "submitted to the Administrator via WhatsApp groups"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "prosecutor updates the WhatsApp group with the final case outcome"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "Item listing is sent via WhatsApp"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "Roster of leave is communicated via the WhatsApp"}]}
{"id": "lst-02", "type": "list", "question": "Which agencies have asked for an HR information or management system?", "reference": "CANU (an HRIS for personnel records, appraisals, leave and contracts), the Guyana Police Force (a full-service agency-wide HRIS, its top ICT priority) and the Forensic Science Laboratory (a Human Resource Management System with orientation checklists, personnel files, recruitment and leave).", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "CANU has expressed a desire for a HRIS system"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "Implementation of a full-service HRIS management system agency-wide"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "the need for a Human Resource Management System to be implemented"}]}
{"id": "lst-03", "type": "list", "question": "Which agencies keep their stores records in manual books such as issue books, ledgers and bin cards?", "reference": "CANU's storekeepers enter requested items into an Issue receipt book and keep Goods Received logbooks; the Prison Service Stores Officer manually updates the RTP, Dietary Goods Received logbook, Stores Ledger and Bin Cards; the Police Quartermaster records received items in red on Bin Cards and the General 83 stock ledger.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "Requested items are entered into an Issue receipt book"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "RTP with tally of goods received"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "Items received will be written in red on the Bin Cards"}]}
{"id": "lst-04", "type": "list", "question": "What are the main problems the General Register Office faces?", "reference": "The IMS database is new and lacks database capabilities and data security protocols; naturalized citizens cannot be searched in the IMS and processes are vulnerable to forgery and false identities; the phone system is often out of order so applicants cannot check status; certificates are not standard sizes; and there is a major backlog of corrections due to manual cancellations, data entry and verification.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "Database capabilities and data security protocols are still not in place"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "Naturalized citizens cannot be searched in the IMS"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "the phone system is often out of order"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "major backlog is currently experienced"}]}
{"id": "lst-05", "type": "list", "question": "Which outside bodies does the Prison Service work with, and for what?", "reference": "The Police Force, Fire Service and Defence Force for riot control and prison searches; the Ministry of Health (an MOU for doctors and nurses); MoHA Finance for payment approvals and checks; the Ministry of Education for training standards; the Ministry of Agriculture to train offenders on prison farms; MoHA Personnel for HR; and NDMA, which hosts the PRIMUS offender database.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "riot control and prison searches, the GPS works with"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "maintains a memorandum of understanding (MOU) to employ"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "works with the Ministry of Agriculture to help train offenders"}]}
{"id": "lst-06", "type": "list", "question": "Which other agencies does CANU work with or want to share data with?", "reference": "CANU is supported by the Guyana Police Force and its SOCU, the Guyana Revenue Authority, the Ministry of Finance's Financial Intelligence Unit and the Guyana Defence Force; it wants a shared database with Immigration Support Services, GRA and the Elections Commission; NCP shares information with CANU regularly; and GFSL notes it has no systems to share data with GPF and CANU.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "Guyana Revenue Authority (GRA), The Ministry of Finance"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "Sharing intelligence and other information will facilitate investigations"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "include the Customs Anti Narcotic Unit (CANU), Police, Prisons"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "they have no systems which allow the agencies to share"}]}
#
# --- process: ordered steps spread over several chunks ---
{"id": "prc-01", "type": "process", "question": "Walk me through what happens to a birth certificate request at the GRO, from the front desk to collecting the certificate.", "reference": "The receptionist logs the application and gives a return slip (within 2 weeks), the applicant pays the cashier, the Search Supervisor distributes applications to searchers who check the IMS, the Print Supervisor allocates printing to printers who print, log and staple the certificates, certificates are sealed, and the Dispatch Clerk files them alphabetically and hands them over against the receipt, with the applicant signing the logbook.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "Application details are logged in Log book"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "Print Supervisor Allocates work or batch file assignment to Printers"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "Dispatch Clerk collects sealed certificate from sealing department"}]}
{"id": "prc-02", "type": "process", "question": "What are the stages of joining the Guyana Police Force, from applying to being posted?", "reference": "Recruitment is announced, the applicant submits the pre-employment questionnaire and takes the GPF entrance exam, CID and Special Branch do background checks and vetting, the background form goes to the applicant's police division, medicals are done and collected for the GMO, the shortlisted applicant has a drug test and interview, files go to the Commissioner of Police for approval to enlist, the applicant is sworn in and given a regulation number and kit, completes Junior Rank training at Felix Austin Police College, and is posted to a work location.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "GPF Entrance Examination is taken and marked"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "Background form with applicant photo is forwarded to the Police Division"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "forwarded to the Commissioner of Police for approval to be enlisted"}]}
{"id": "prc-03", "type": "process", "question": "How does someone go from applying to a community policing group to holding their ID card?", "reference": "The applicant fills in a paper form and gives it to an agent, it goes to the Liaison who interviews the applicant and takes photo and signature, the Liaison brings it to the central office where it is scanned; the scanned application is emailed to the ISIS Supervisor, the photo and signature are clipped and imported into CorelDRAW and placed on a region-coloured ID template, the card is printed and approved by the Administrator, and the Liaison hand-delivers it to the new member.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "New CPG applicant completes paper form and submits form to an agent"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "ISIS Supervisor is emailed the previously scanned membership application"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "imported into photo editor application"}]}
{"id": "prc-04", "type": "process", "question": "Describe the steps a prison follows to buy goods, from the purchase request to closing the payment.", "reference": "The facility Stores Officer completes a Request to Purchase with a quotation, the OIC and the OIC of Finance approve it, the RTP Desk Clerk enters it in QuickBooks and an LPO is prepared, the Verification Desk certifies the voucher, the Votes Ledger Clerk records it, the Director of Prisons approves, the voucher goes to MoHA Finance, prison staff uplift the check from MoHA, Prison Finance confirms delivery and notifies the location, and the payment voucher is reviewed and sent back to MoHA Finance to complete the process.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "Stores Officer at a prison facility completes Request to Purchase"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "inputs RTP into QuickBooks program"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "Prison staff sent to MoHA to uplift check"}]}
{"id": "prc-05", "type": "process", "question": "What happens to crime-scene evidence at the forensic lab from drop-off until the police officer collects the results?", "reference": "The officer brings the evidence to GFSL, security verifies identity and logs the visit, the Evidence Officer receives it with a Chain of Custody form, logs it and creates a VeriPic case and receipt; the analyst analyses it and prepares the worksheet, statement and Certificate of Analysis, a reviewer checks it, the Director crimps the COA, the file is scanned and stored until the submitting officer uplifts it, receiving the evidence, certificate of analysis and original form.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "Security Officer verifies visitor identity"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "Director upon satisfaction of contents crimps the COA"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "stores files in cupboard until the submitting officer comes to uplift"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "issued with the evidence, certificate of analysis"}]}
{"id": "prc-06", "type": "process", "question": "Walk me through the intake of a young person at the juvenile holding centre.", "reference": "The youth and escort arrive with the arrest warrant and birth certificate, a photo is taken and weight/height recorded, the admissions form is completed and copied (original to the Police file), the copy is hand-delivered to the Administrative Assistant, who scans the birth certificate into the JHC Database and opens a new file, and the assigned social worker is verbally notified that the youth has arrived.", "expected": [{"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "Youth and escort arrive at the facility"}, {"filename": "MoHA Guyana Booklet_V3.pdf", "contains": "the original is filed in the Police file"}]}
